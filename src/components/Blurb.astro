---
interface Props {
  id?: string;
  align?: 'left' | 'right';
  title: string;
  class?: string;
}

const { id, align = 'left', title, class: className } = Astro.props;
---

<article id={id} class={`blurb-card ${align} ${className ?? ''}`}>
  <h2>{title}</h2>
  <div class="blurb-body">
    <slot />
  </div>
</article>
