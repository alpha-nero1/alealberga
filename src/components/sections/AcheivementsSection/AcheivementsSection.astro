---
import Blurb from '../../Blurb.astro';
import './AcheivementsSection.css';
import cciImage from '../../../assets/images/cci.jpg';
import solutionsArchitectImage from '../../../assets/images/solutions_architect.webp';
import udemyImage from '../../../assets/images/udemy.png';
import utsImage from '../../../assets/images/uts.png';
import fluentSrs from '../../../assets/images/fluentsrs.png';

// Description copy is written as multiline template literals for easier review/editing,
// then collapsed back into flowing single-line paragraph text for rendering.
const clean = (text: string) => text.replace(/\s+/g, ' ').trim();

const achievements = [
  {
    title: 'FluentSRS | An app for language enthusiasts',
    description: clean(`
      A worthy mention in my arsenal of projects, FluentSRS is a mobile app aimed at revolutionising language learning
      putting the focus back on speaking and continual improvement, bringing the user ever closer to a native speaking
      level of fluency. The app I wanted for learning languages didn't exist, so, I built it!
    `),
    year: '2026',
    accent: '#4fd4c4',
    link: 'https://preview.fluentsrs.pages.dev',
    image: fluentSrs
  },
  {
    title: 'Complete Dart/Flutter course | Udemy',
    description: clean(`
      By Maximillian Schwarzmuller, this 30 hour course provided me with the rock-solid foundation I needed to be able to hit the ground running
      in my new role at Mates.com!
    `),
    year: '2026',
    accent: '#4fd4c4',
    link: 'https://www.udemy.com/course/learn-flutter-dart-to-build-ios-android-apps',
    image: udemyImage
  },
  {
    title: 'AI Engineer Agentic Track: The Complete Agent & MCP Course | Udemy',
    description: clean(`
      By Ed Donner, this 21 hour course teaches you the ins and outs of so many new AI technologies and frameworks,
      from OpenAI Agents, to CrewAI, LangGraph and MCP servers this holistic agentic course gave me the leg up I needed
      to pioneer agentic solutions in my career.
    `),
    year: '2025',
    accent: '#4fd4c4',
    link: 'https://www.udemy.com/course/the-complete-agentic-ai-engineering-course',
    image: udemyImage
  },
  {
    title: 'Associate AWS Solutions Architect | AWS',
    description: clean(`
      The AWS-SOC3 certification is an important certification from AWS, certifying that the holder understands the AWS ecosystem
      and the exact tech to bring to the table to implement resilient, scalable and high performant solutions.
    `),
    year: '2024',
    accent: '#f2b36f',
    link: 'https://docs.aws.amazon.com/aws-certification/latest/solutions-architect-associate-03/solutions-architect-associate-03.html',
    image: solutionsArchitectImage,
  },
  {
    title: 'Python for Machine Learning & Data Science Masterclass | Udemy',
    description: clean(`
      This amazing 44 hour course by Jose Portilla, provided in depth knowledge and know-how of building machine learning solutions, before agentic AI (and still to this day)
      classic ML models are fantastic for powering predictive workflows. This course empowered me to build AI solutions such as fraud detection algorithms, churn detection models
      and user segmentation algorithms.
    `),
    year: '2023',
    accent: '#7b61ff',
    link: 'https://www.udemy.com/course/python-for-machine-learning-data-science-masterclass',
    image: udemyImage
  },
  {
    title: 'All 189 questions of the Cracking the Coding Interview',
    description: clean(`
      In my humble opinion this masterpiece by Gayle Laakmann McDowell is a rite of passage for any developer into the path of seniority. Solving each
      of the questions in this comprehensive book and comparing my solutions to those in the book truly empowered me to be able to tackle any size of programming
      challenge with confidence, greatly aiding me in my career.
    `),
    year: '2021',
    accent: '#59c3c3',
    link: 'https://github.com/alpha-nero1/KnowledgeBase/tree/master/Courses/CrackingTheCodingInterview',
    image: cciImage,
  },
  {
    title: 'Graduated at UTS',
    description: clean(`
      Having graduated from UTS with a bachelor of IT co-op scholarship, I was set up to begin a rewarding career in software development, from programming courses
      to important industry placements, as well as a great cohort of UTS' best and brightest to learn from, my 3 years at UTS gave me the set up I needed.
    `),
    year: '2018',
    accent: '#59c3c3',
    link: 'https://www.uts.edu.au/for-students/admissions-entry/scholarships/scholarships-search/bachelor-of-information-technology-co-op-scholarship',
    image: utsImage
  },
];
---

<Blurb id="reputation" align="right" title="How I keep on top of an ever evolving industry">
  <p>
    It's critical to continually sharpen the sword, apart from small projects I have done in my own time, 
    these are the specific things I have done to keep on top of my game
  </p>

  <div class="achievement-carousel">
    <button class="achievement-nav achievement-nav--prev" type="button" aria-label="Previous achievement" data-dir="-1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <ul class="achievement-track">
      {achievements.map((item, index) => {
        return (
        <li class="achievement-card" style={`--accent: ${item.accent}; --tilt: 0deg;`}>
          <div class="achievement-card-image" style={`background: linear-gradient(150deg, ${item.accent}33, ${item.accent}0d);`}>
            {item.image && <img src={item.image.src} alt={item.title} />}
          </div>
          <div class="achievement-card-body">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <div class="achievement-card-footer">
            <span class="achievement-chip">{item.year}</span>
            <a class="achievement-link" href={item.link} target="_blank" rel="noreferrer">Find out more</a>
          </div>
        </li>
        );
      })}
    </ul>

    <button class="achievement-nav achievement-nav--next" type="button" aria-label="Next achievement" data-dir="1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</Blurb>

<script>
  document.querySelectorAll<HTMLElement>('.achievement-carousel').forEach((carousel) => {
    const trackEl = carousel.querySelector<HTMLElement>('.achievement-track');
    if (!trackEl) return;
    const track = trackEl;

    function cardStep() {
      const card = track.querySelector('.achievement-card');
      return card ? card.getBoundingClientRect().width + 22 : track.clientWidth;
    }

    function scrollByCards(dir: number) {
      track.scrollBy({ left: dir * cardStep(), behavior: 'smooth' });
    }

    carousel.querySelectorAll('.achievement-nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        scrollByCards(Number(btn.getAttribute('data-dir') ?? '1'));
      });
    });

    let isDragging = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (e.target instanceof HTMLElement && e.target.closest('a, button')) return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartScroll = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
      track.classList.add('is-dragging');
    });

    track.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 8) dragMoved = true;
      track.scrollLeft = dragStartScroll - delta;
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');

      const delta = track.scrollLeft - dragStartScroll;
      const threshold = cardStep() * 0.2;
      let target = dragStartScroll;

      if (Math.abs(delta) > threshold) {
        target = dragStartScroll + (delta > 0 ? cardStep() : -cardStep());
      }

      target = Math.max(0, Math.min(target, track.scrollWidth - track.clientWidth));
      track.scrollTo({ left: target, behavior: 'smooth' });
    }

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    track.addEventListener('click', (e) => {
      if (dragMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    let idleTimer: ReturnType<typeof setTimeout> | null = null;

    function autoAdvance() {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      if (atEnd) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        scrollByCards(1);
      }
      scheduleAutoScroll();
    }

    function scheduleAutoScroll() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(autoAdvance, 5000);
    }

    function pauseAutoScroll() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = null;
    }

    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((evt) => {
      carousel.addEventListener(evt, scheduleAutoScroll, { passive: true });
    });
    carousel.addEventListener('pointerenter', pauseAutoScroll);
    carousel.addEventListener('pointerleave', scheduleAutoScroll);

    scheduleAutoScroll();
  });
</script>
