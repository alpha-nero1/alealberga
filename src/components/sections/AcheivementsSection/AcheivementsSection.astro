---
import Blurb from '../../Blurb.astro';
import './AcheivementsSection.css';
import cciImage from '../../../assets/images/cci.jpg';
import solutionsArchitectImage from '../../../assets/images/solutions_architect.webp';
import udemyImage from '../../../assets/images/udemy.png';
import utsImage from '../../../assets/images/uts.png';
import fluentSrs from '../../../assets/images/fluentsrs.png';

const achievements = [
  {
    title: 'FluentSRS | An app for language enthusiasts',
    description: 'An app that I built, pending appstore approval which revolutionlises the way we learn languages, taking the focus away from doom streaks of memorisation and towards speaking and producing the language.',
    year: '2026',
    accent: '#4fd4c4',
    link: 'https://preview.fluentsrs.pages.dev',
    image: fluentSrs
  },
  {
    title: 'Complete Dart/Flutter course | Udemy',
    description: 'By Maximillian Schwarzmuller, this 30 hour course ',
    year: '2026',
    accent: '#4fd4c4',
    link: 'https://www.udemy.com/course/learn-flutter-dart-to-build-ios-android-apps',
    image: udemyImage
  },
  {
    title: 'AI Engineer Agentic Track: The Complete Agent & MCP Course | Udemy',
    description: '',
    year: '2025',
    accent: '#4fd4c4',
    link: 'https://www.udemy.com/course/the-complete-agentic-ai-engineering-course',
    image: udemyImage
  },
  {
    title: 'Associate AWS Solutions Architect | AWS',
    description: 'A short placeholder description of this achievement. Swap this out for the real story once you have it.',
    year: '2024',
    accent: '#f2b36f',
    link: 'https://docs.aws.amazon.com/aws-certification/latest/solutions-architect-associate-03/solutions-architect-associate-03.html',
    image: solutionsArchitectImage,
  },
  {
    title: 'Python for Machine Learning & Data Science Masterclass | Udemy',
    description: 'A short placeholder description of this achievement. Swap this out for the real story once you have it.',
    year: '2023',
    accent: '#7b61ff',
    link: 'https://www.udemy.com/course/python-for-machine-learning-data-science-masterclass',
    image: udemyImage
  },
  {
    title: 'All 189 questions of the Cracking the Coding Interview',
    description: 'A short placeholder description of this achievement. Swap this out for the real story once you have it.',
    year: '2021',
    accent: '#59c3c3',
    link: 'https://github.com/alpha-nero1/KnowledgeBase/tree/master/Courses/CrackingTheCodingInterview',
    image: cciImage,
  },
  {
    title: 'Graduated at UTS',
    description: 'A short placeholder description of this achievement. Swap this out for the real story once you have it.',
    year: '2018',
    accent: '#59c3c3',
    link: 'https://www.uts.edu.au/for-students/admissions-entry/scholarships/scholarships-search/bachelor-of-information-technology-co-op-scholarship',
    image: utsImage
  },
];
---

<Blurb id="reputation" align="right" title="Cool things I have done over the years">
  <p>
    Over the years I have acheived several feats that I am proud of
  </p>

  <div class="achievement-carousel">
    <button class="achievement-nav achievement-nav--prev" type="button" aria-label="Previous achievement" data-dir="-1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <ul class="achievement-track">
      {achievements.map((item, index) => {
        return (
        <li class="achievement-card" style={`--accent: ${item.accent}; --tilt: 0deg;`}>
          <div class="achievement-card-image" style={`background: linear-gradient(150deg, ${item.accent}33, ${item.accent}0d);`}>
            {item.image && <img src={item.image.src} alt={item.title} />}
          </div>
          <div class="achievement-card-body">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <div class="achievement-card-footer">
            <span class="achievement-chip">{item.year}</span>
            <a class="achievement-link" href={item.link} target="_blank" rel="noreferrer">Find out more</a>
          </div>
        </li>
        );
      })}
    </ul>

    <button class="achievement-nav achievement-nav--next" type="button" aria-label="Next achievement" data-dir="1">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</Blurb>

<script>
  document.querySelectorAll<HTMLElement>('.achievement-carousel').forEach((carousel) => {
    const trackEl = carousel.querySelector<HTMLElement>('.achievement-track');
    if (!trackEl) return;
    const track = trackEl;

    function cardStep() {
      const card = track.querySelector('.achievement-card');
      return card ? card.getBoundingClientRect().width + 22 : track.clientWidth;
    }

    function scrollByCards(dir: number) {
      track.scrollBy({ left: dir * cardStep(), behavior: 'smooth' });
    }

    carousel.querySelectorAll('.achievement-nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        scrollByCards(Number(btn.getAttribute('data-dir') ?? '1'));
      });
    });

    let isDragging = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (e.target instanceof HTMLElement && e.target.closest('a, button')) return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartScroll = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
      track.classList.add('is-dragging');
    });

    track.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 8) dragMoved = true;
      track.scrollLeft = dragStartScroll - delta;
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');

      const delta = track.scrollLeft - dragStartScroll;
      const threshold = cardStep() * 0.2;
      let target = dragStartScroll;

      if (Math.abs(delta) > threshold) {
        target = dragStartScroll + (delta > 0 ? cardStep() : -cardStep());
      }

      target = Math.max(0, Math.min(target, track.scrollWidth - track.clientWidth));
      track.scrollTo({ left: target, behavior: 'smooth' });
    }

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    track.addEventListener('click', (e) => {
      if (dragMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    let idleTimer: ReturnType<typeof setTimeout> | null = null;

    function autoAdvance() {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      if (atEnd) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        scrollByCards(1);
      }
      scheduleAutoScroll();
    }

    function scheduleAutoScroll() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(autoAdvance, 5000);
    }

    function pauseAutoScroll() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = null;
    }

    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((evt) => {
      carousel.addEventListener(evt, scheduleAutoScroll, { passive: true });
    });
    carousel.addEventListener('pointerenter', pauseAutoScroll);
    carousel.addEventListener('pointerleave', scheduleAutoScroll);

    scheduleAutoScroll();
  });
</script>
