---
import { getCollection } from 'astro:content';
import Blurb from '../../Blurb.astro';
import './BlogsSection.css';

const previews = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Blurb id="blogs" align="left" title="From the blog">
  <p>
    I write up lessons from shipping products, mostly around Flutter, frontend architecture, and AI-assisted
    workflows. New posts are on the way.
  </p>
  <div class="blog-preview-list">
    {previews.map((post) => (
      <a class="blog-preview-card" href={`/blogs/${post.id}`}>
        <h3>{post.data.title}</h3>
        <p>{post.data.excerpt}</p>
      </a>
    ))}
  </div>
  <a class="blog-preview-link" href="/blogs">Visit the blog →</a>
</Blurb>
