---
import Blurb from '../../Blurb.astro';
import './EmploymentHistorySection.css';
import allonPacificLogo from '../../../assets/images/allon_pacific_logo.png';
import infotrackLogo from '../../../assets/images/infotrack_logo.png';
import matesLogo from '../../../assets/images/mates_icon.png';

const CURRENT_YEAR = 2026;

function formatDuration(start, end) {
  const years = Math.max(end - start, 0);
  if (years === 0) return '< 1 yr';
  return `${years} ${years === 1 ? 'yr' : 'yrs'}`;
}

const jobs = [
  {
    company: 'Allon Pacific',
    role: 'Software Engineer',
    description: 'I owe my start in the tech industry to Allon, and to industry legend Dave Watson (my Obi-Wan Kenobi), at Allon I worked closely with the CTO to deliver an international education consulting product (website and app) learning the ins and outs of software development from the best in the business.',
    start: 2019,
    end: 2021,
    accent: '#000',
    logo: allonPacificLogo,
  },
  {
    company: 'InfoTrack',
    role: 'Senior Software Engineer / Team Leader',
    description: 'From small start-up esque teams focusing on B2C legal offerings to big heavy weight electronic settlement teams like SettleIT, at InfoTrack I was able to get rich experience in almost every flavour of enterprise product, and in a variation of roles, moving into a senior engineer role and then team leadership',
    start: 2021,
    end: 2026,
    accent: '#fff',
    logo: infotrackLogo,
  },
  {
    company: 'mates.com',
    role: 'Front End Engineering Lead',
    description: 'Leading the front end app development at Mates.com, an ambitious startup aiming to flip the world of social economics on its head, I am responsible for our Flutter iOS and Android development in a high stakes environment.',
    start: 2026,
    end: CURRENT_YEAR,
    current: true,
    accent: '#000',
    logo: matesLogo,
  },
];
---

<Blurb id="now" align="left" title="Where I have worked">
  <p>
    Over the years I have worked at small start-ups to big companies like InfoTrack.
    Here is what I got up to on the tools:
  </p>

  <div class="timeline">
    <ol class="timeline-track">
      {[...jobs].reverse().map((job) => (
        <li class="timeline-item">
          <div class="timeline-marker-col">
            <span class="timeline-marker" style={`background:${job.accent}`}></span>
          </div>
          <div class="timeline-content">
            <span class="timeline-range">
              {job.start} – {job.current ? 'Present' : job.end}
              <span class="timeline-duration">({formatDuration(job.start, job.current ? CURRENT_YEAR : job.end)})</span>
            </span>
            <div class="timeline-card">
              <div class="timeline-card-head">
                <span class="timeline-logo" style={`background:${job.accent}`}>
                  <img src={job.logo.src} alt={`${job.company} logo`} />
                </span>
                <div>
                  <h3>{job.company}</h3>
                  <p class="timeline-role">{job.role}</p>
                </div>
              </div>
              <p class="timeline-description">{job.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Blurb>
