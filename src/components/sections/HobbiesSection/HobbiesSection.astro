---
import Blurb from '../../Blurb.astro';
import './HobbiesSection.css';

const hobbies = [
  {
    name: 'Running',
    blurb: 'I love to run, if I could I would wake up, run all day and go to bed. Having completed my first marathon recently, I aim to compete competitively in the future.',
    icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z',
    accent: '#4fd4c4',
  },
  {
    name: 'Coding!',
    blurb: 'Ever since year 11 software class with Mr. Katovic, I have loved to write code. You will often find me at home hunkering down in a personal project I am very passionate about.',
    icon: 'M4 19V6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v13M4 19a2 2 0 0 0 2 2h11M4 19a2 2 0 0 1 2-2h11V6',
    accent: '#f2b36f',
  },
  {
    name: 'Languages',
    blurb: 'Fluent in Italian and trying my hardest in German, I find language learning so interesting and rewarding, so much so that I built an app to help me learn!',
    icon: 'M12 3v4M5.6 5.6l2.8 2.8M3 12h4M5.6 18.4l2.8-2.8M12 21v-4M18.4 18.4l-2.8-2.8M21 12h-4M18.4 5.6l-2.8 2.8',
    accent: '#7b61ff',
  },
  {
    name: 'Dogs',
    blurb: 'As a proud dog dad to two fur babies, I enjoy going for walks and playing with my little rascals (message me for pics).',
    icon: 'M3 11l18-7-7 18-3-8-8-3Z',
    accent: '#59c3c3',
  },
];
---

<Blurb id="growth" align="left" title="What I do in my spare time">
  <p>
    From running, gym, languages, coding and walking the dogs, here's what I find fun!
  </p>
  <div class="hobby-list">
    {hobbies.map((hobby) => (
      <div class="hobby-item">
        <span class="hobby-icon" style={`color:${hobby.accent}`}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={hobby.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <h3>{hobby.name}</h3>
        <p>{hobby.blurb}</p>
      </div>
    ))}
  </div>
</Blurb>
