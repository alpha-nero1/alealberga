---
import Blurb from '../../Blurb.astro';
import './HobbiesSection.css';

const hobbies = [
  {
    name: 'Running/Gym',
    blurb: 'A short placeholder description of this hobby and why you enjoy it. Swap this out for the real story once you have it.',
    icon: 'M12 21s-7-4.35-9.5-8.5C.5 8.5 2.5 5 6 5c2 0 3.5 1 4 2 0.5-1 2-2 4-2 3.5 0 5.5 3.5 3.5 7.5C19 16.65 12 21 12 21Z',
    accent: '#4fd4c4',
  },
  {
    name: 'Coding!',
    blurb: 'Ever since year 11 software class with Mr. Katovic I have been lost in the code',
    icon: 'M4 19V6a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v13M4 19a2 2 0 0 0 2 2h11M4 19a2 2 0 0 1 2-2h11V6',
    accent: '#f2b36f',
  },
  {
    name: 'Languages',
    blurb: 'Fluent in Italian and making an effort in German, langugaes really intrigue me, so much so that I built an app to help me learn!',
    icon: 'M12 3v4M5.6 5.6l2.8 2.8M3 12h4M5.6 18.4l2.8-2.8M12 21v-4M18.4 18.4l-2.8-2.8M21 12h-4M18.4 5.6l-2.8 2.8',
    accent: '#7b61ff',
  },
  {
    name: 'Dogs',
    blurb: 'As a proud dog dad to two furr babies, I enjoy going for walks and playing with my little rascals',
    icon: 'M3 11l18-7-7 18-3-8-8-3Z',
    accent: '#59c3c3',
  },
];
---

<Blurb id="growth" align="left" title="Hobbies">
  <p>
    What I get up to in my spare time.
  </p>
  <div class="hobby-list">
    {hobbies.map((hobby) => (
      <div class="hobby-item">
        <span class="hobby-icon" style={`color:${hobby.accent}`}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={hobby.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <h3>{hobby.name}</h3>
        <p>{hobby.blurb}</p>
      </div>
    ))}
  </div>
</Blurb>
