---
import Layout from '../layouts/Layout.astro';
import './index.css';
import SpecialiseSection from '../components/sections/SpecialiseSection/SpecialiseSection.astro';
import AcheivementsSection from '../components/sections/AcheivementsSection/AcheivementsSection.astro';
import EmploymentHistorySection from '../components/sections/EmploymentHistorySection/EmploymentHistorySection.astro';
import HobbiesSection from '../components/sections/HobbiesSection/HobbiesSection.astro';
import ContactSection from '../components/sections/ContactSection/ContactSection.astro';
import BlogsSection from '../components/sections/BlogsSection/BlogsSection.astro';
import AleBotSection from '../components/sections/AleBotSection/AleBotSection.astro';

---

<Layout>
  <div id="container">
    <main>
      <section id="home">
        <div class="hero-copy">
          <h1>Alessandro (Ale)</h1>
          <h1>Alberga</h1>
          <p class="hero-intro">
            Well hello hello, my name is Ale. I am a Senior Software Engineer based in Sydney, Australia specialising in front end
            application development with a focus on flutter used for iOS and Android apps.
          </p>
          <p class="hero-intro">
            However, I am no stranger to enterprise systems having worked in full stack and hollistic roles
            for most of my career.
          </p>
          <p class="hero-intro">
            One thing for certain is this, I love to code and deliver products that make a difference. This is
            how I am able to hold a Job and never work a day in my life!
          </p>
        </div>

        <aside class="hero-portrait-card" aria-label="Professional portrait">
          <div class="hero-portrait-frame">
            <img src="/me.PNG" alt="Professional portrait placeholder" />
          </div>
        </aside>
      </section>
      <div id="main-content">
        <!-- What I specialise in section. -->
        <SpecialiseSection />
        <!-- Stuff I am proud of section. -->
        <AcheivementsSection />
        <!-- Employment history section. -->
        <EmploymentHistorySection />
        <!-- What I do in spare time section. -->
        <HobbiesSection />
        <!-- Contact section. -->
        <ContactSection />
        <!-- Blog previews section. -->
        <BlogsSection />
      </div>
    </main>
    <AleBotSection />
  </div>
</Layout>

