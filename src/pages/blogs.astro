---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import './index.css';
import './blogs.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blogs | Ale Alberga"
  description="Thoughts on software engineering, Flutter, front-end architecture, and AI — written by Ale Alberga."
>
  <div id="container">
    <main class="blog-page">
      <section id="home">
        <h1>Blogs</h1>
      </section>

      {posts.length === 0 ? (
        <p class="hero-intro">Writing in progress. New posts are on the way.</p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li class="blog-list-item">
              <a href={`/blogs/${post.id}`}>
                <p class="blog-list-date">
                  {post.data.pubDate.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <h2>{post.data.title}</h2>
                <p class="blog-list-excerpt">{post.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </div>
</Layout>
